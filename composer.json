{
  "name": "tareq-alqadi/filament-flatpickr",
  "description": "Integrate Flatpickr with FilamentPHP",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "TareqAlqadi\\FilamentFlatpickr\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "TareqAlqadi\\FilamentFlatpickr\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.2",
    "filament/forms": "^4.0|^5.0",
    "filament/support": "^4.0|^5.0",
    "illuminate/contracts": "^11.28|^12.0|^13.0",
    "spatie/laravel-package-tools": "^1.15.0"
  },
  "require-dev": {
    "orchestra/testbench": "^9.0|^10.0|^11.0",
    "pestphp/pest": "^3.0|^4.0",
    "pestphp/pest-plugin-laravel": "^3.0|^4.0"
  },
  "scripts": {
    "test": "pest"
  },
  "authors": [
    {
      "name": "Tareq Al-Qadi",
      "email": "alqadi.tareq199@gmail.com",
      "role": "Developer"
    }
  ],
  "extra": {
    "laravel": {
      "providers": [
        "TareqAlqadi\\FilamentFlatpickr\\FilamentFlatpickrServiceProvider"
      ],
      "aliases": {
        "FilamentFlatpickr": "TareqAlqadi\\FilamentFlatpickr\\Facades\\FilamentFlatpickr"
      }
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "prefer-stable": true
}
